+/**
+ * Package-internal carrier for the host tool-dispatch authority.
+ *
+ * `dsh-tools` mints at most one {@link ToolDispatchAuthority} per registry and
+ * the agent loop claims it during construction. The authority must reach
+ * `tool-calls.ts` without becoming a service member, a class field, or an
+ * export: a field would be readable through the public `ctx.agentLoop`
+ * service instance, and an export would make it importable. A module-private
+ * `WeakMap` keyed by the loop's own context keeps it out of both.
+ *
+ * Nothing here is re-exported from `index.ts`, and `package.json` publishes
+ * `lib/**` only, so an installed plugin cannot reach this binding.
+ * @module @deepseek-ai/dsh-agent-loop/internal
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type { ToolDispatchAuthority } from '@deepseek-ai/dsh-tools'
+
+/**
+ * One app-owned host dispatcher: the exact tool registry it targets and the
+ * authority that registry minted. Keyed by the root context so a loop reload
+ * (a new loop fiber or a drained-and-replaced loop) reuses the same authority
+ * instead of trying to claim a second one, while an independently restarted
+ * tool registry is detected by identity and re-claimed.
+ * @internal
+ */
+export interface HostDispatcher {
+  /** The raw `ToolRuntime` instance the authority belongs to. */
+  readonly registry: object
+  readonly authority: ToolDispatchAuthority
+}
+
+/**
+ * Root context → the app's host dispatcher.
+ * @internal
+ */
+export const hostDispatchers: WeakMap<Context, HostDispatcher> = new WeakMap()
