+    expectUntrusted(await host.tools.execute({} as ToolExecutionInput))
+    expectInvalid(await host.tools.execute(null as unknown as ToolExecutionInput))
+  })
+
+  it('T14 a restarted host accepts no execution object from the previous process', async () => {
+    const first = await harness([toolCallResponse('c1', 'probe', {}), textResponse('done')])
+    const seen: ToolRunContext[] = []
+    first.tools.register(probeTool(seen))
+    const agent = await liveAgent(first, 't14-before-restart')
+    const idle = waitForIdle(first, agent)
+    followup(agent)
+    await idle
+    const previousProcessExec = seen[0]!
+
+    // A new Context/registry stands in for a restarted host: authority state,
+    // single-use sets, and execution identities are all process-local memory.
+    const restarted = await harness()
+    const restartedSeen: ToolRunContext[] = []
+    restarted.tools.register(probeTool(restartedSeen))
+    const restartedAgent = await liveAgent(restarted, 't14-after-restart')
+
+    expectUntrusted(await restarted.tools.execute(previousProcessExec))
+    expectUntrusted(await restarted.tools.execute({ ...previousProcessExec, agent: restartedAgent }))
+    expect(restartedSeen).toHaveLength(0)
+    // The new host still dispatches its own calls normally.
+    expect(restartedSeen).toHaveLength(0)
+    expect(authorityOf(restarted)).not.toBe(authorityOf(first))
+  })
+})
