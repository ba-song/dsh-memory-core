+
+    const result = ctx.agents.withInitiator(owner, () => ctx.tools.execute({
+      callId: ToolCallId('initiator-forged'),
+      name: 'probe',
+      arguments: {},
+      agent: owner,
+      signal: new AbortController().signal,
+    }))
+    expectUntrusted(await result)
+    expect(ctx.agents.currentInitiator).toBeTypeOf('function')
+    expect(seen).toHaveLength(0)
+  })
+
+  it('T06 the signing authority is claimed once and cannot be obtained afterwards', async () => {
+    const ctx = await harness()
+    const authority = authorityOf(ctx)
+    expect(authority).toBeTypeOf('object')
+
+    expect(() => ctx.tools.claimDispatchAuthority()).toThrow(/already been claimed/)
+    // A second claim never yields a second capability.
+    let claimed: unknown
+    try { claimed = ctx.tools.claimDispatchAuthority() } catch { claimed = undefined }
+    expect(claimed).toBeUndefined()
+  })
+
+  it('T06b a pre-startup claimant disables the host dispatcher instead of sharing it', async () => {
+    // The claim is first-come because cordis activates plugins concurrently and
+    // exposes no caller identity. That race is fail-closed: if anything claims
+    // before the agent loop, the loop cannot register its agent factory, so no
+    // live host identity exists for the pre-claiming party to borrow.
+    const ctx = new Context()
+    await ctx.plugin(LlmRuntime)
+    await ctx.plugin(SessionStore)
+    await ctx.plugin(SessionProjectionRegistry)
+    await ctx.plugin(SystemPrompt, { personaPrefix: '' })
+    await ctx.plugin(ToolRuntime)
+    await ctx.plugin(AgentRegistry)
+    onTestFinished(() => ctx.fiber.dispose())
+
+    expect(ctx.tools.claimDispatchAuthority()).toBeTypeOf('object')
+    await expect(ctx.plugin(AgentLoop, { agents: [] })).rejects.toMatchObject({ code: TOOL_EXEC_UNTRUSTED })
+    await expect(ctx.agents.create({
+      sessionId: SessionId('t06b'), agentOptions: { provider: 'mock', model: 'mock' },
+    })).rejects.toThrow(/no agent factory/)
+  })
+
+  it('T07 no internal dispatch surface is exported or attached to the service', async () => {
+    const ctx = await harness()
+
+    // 1. The package namespace no longer publishes the staged scheduler.
+    expect('TOOL_RUNTIME_SCHEDULER' in toolsNamespace).toBe(false)
+    expect('schedulerOf' in toolsNamespace).toBe(false)
+
+    // 2. The service proxy (and the raw cordis target behind it) carry no
+    //    dispatch capability and no callable pipeline stage.
+    const raw = (ctx.tools as unknown as Record<symbol, unknown>)[Symbol.for('cordis.original')]
+    for (const surface of [ctx.tools as unknown as Record<string, unknown>, raw as Record<string, unknown>]) {
+      expect(surface['prepareScheduledExecution']).toBeUndefined()
+      expect(surface['prepareExecution']).toBeUndefined()
+      expect(surface['createExecution']).toBeUndefined()
+      expect(surface['dispatchScheduledExecution']).toBeUndefined()
+      expect(surface['dispatchToolBody']).toBeUndefined()
+      expect(surface['finalizeScheduledExecution']).toBeUndefined()
+      expect(surface['finishScheduledExecution']).toBeUndefined()
+      expect(surface['dispatchAuthority']).toBeUndefined()
+      expect(surface['scheduler']).toBeUndefined()
+    }
+
+    // 3. No symbol key exposes a scheduler object either.
+    for (const key of Object.getOwnPropertySymbols(ctx.tools)) {
+      const value = (ctx.tools as unknown as Record<symbol, unknown>)[key]
+      expect(typeof value === 'object' && value !== null && 'prepare' in value).toBe(false)
+    }
+  })
+
+  it('T08 a child execution handle cannot be borrowed by another agent', async () => {
+    const ctx = await harness([toolCallResponse('c1', 'probe', {}), textResponse('done')])
