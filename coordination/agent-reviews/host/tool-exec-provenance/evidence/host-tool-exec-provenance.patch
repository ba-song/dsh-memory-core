+    ctx.tools.register(probeTool(seen))
+    const agent = await liveAgent(ctx, 't10-agent')
+    const idle = waitForIdle(ctx, agent)
+    followup(agent)
+    await idle
+
+    expect(seen).toHaveLength(1)
+    expect(seen[0]?.agent).toBe(agent)
+    expect(seen[0]?.name).toBe('probe')
