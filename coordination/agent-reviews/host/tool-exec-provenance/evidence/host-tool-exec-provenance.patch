+    const parent = await liveAgent(ctx, 't08-parent')
+    const child = await liveAgent(ctx, 't08-child')
+    const idle = waitForIdle(ctx, parent)
+    followup(parent)
+    await idle
+    const genuine = seen[0]!
+
+    // `parent`'s dispatch is not a capability the child session may reuse.
+    expectUntrusted(await ctx.tools.execute({ ...genuine, agent: child }))
+    expect(genuine.agent).toBe(parent)
+    expect(seen).toHaveLength(1)
+  })
+
+  it('T09 an exec cannot be carried across sessions', async () => {
