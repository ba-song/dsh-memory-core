+      const results = agent.session.snapshotEvents().filter(event => event.type === 'tool/result')
+      expect(results).toHaveLength(1)
+    }
+  })
+
+  it('T12 an already-dispatched or settled execution is refused on replay', async () => {
+    const ctx = await harness()
+    const seen: ToolRunContext[] = []
+    ctx.tools.register(probeTool(seen))
+    const agent = await liveAgent(ctx, 't12-agent')
+    const authority = authorityOf(ctx)
+    const input: ToolExecutionInput = {
+      callId: ToolCallId('t12'),
+      name: 'probe',
+      arguments: {},
+      agent,
+      signal: new AbortController().signal,
+    }
+
+    const prepared = await authority.prepare(input)
+    expect(prepared.kind).toBe('dispatch')
+    if (prepared.kind !== 'dispatch') throw new Error('unreachable')
+    const first = await authority.dispatch(prepared.exec)
+    expect(seen).toHaveLength(1)
