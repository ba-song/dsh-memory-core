+/**
+ * Host tool-execution provenance (negative + positive security suite).
+ *
+ * Threat model: an ordinary cordis plugin shares this process and can reach
+ * the `tools` service, the package namespace, live agents, the initiator
+ * boundary, and any execution object a handler or policy listener was given.
+ * It cannot reach the one host dispatch authority the agent loop claimed at
+ * construction. Every case below therefore exercises the SAME surfaces a
+ * plugin has, not a private helper:
+ *
+ * - `ctx.tools.execute(...)` with a hand-built input (T01, T02, T13)
+ * - a registry-minted `ToolRunContext` captured from a tool handler, copied,
+ *   mutated, replayed, or handed to another agent/session (T03, T04, T08, T09,
+ *   T12)
+ * - `ctx.agents.withInitiator(realAgent, ...)` (T05)
+ * - `ctx.tools.claimDispatchAuthority()` after the host claimed it (T06)
+ * - the package namespace, the service proxy, its prototype, and the raw
+ *   cordis target behind the proxy (T07)
+ * - a fresh registry standing in for a restarted host (T14)
+ *
+ * Positive controls prove the host dispatch path (T10) and concurrent
+ * dispatch (T11) still run normally.
+ */
+
+import { describe, expect, it, onTestFinished } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { createUserMessage, ToolCallId, type ContentBlock } from '@deepseek-ai/dsh-llm'
+import LlmRuntime from '@deepseek-ai/dsh-llm'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+import SystemPrompt from '@deepseek-ai/dsh-system-prompt'
+import AgentRegistry, { type Agent } from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import * as toolsNamespace from '@deepseek-ai/dsh-tools'
+import ToolRuntime, {
+  defineTool,
+  TOOL_EXEC_INVALID,
+  TOOL_EXEC_UNTRUSTED,
+  type ToolExecutionInput,
+  type ToolExecutionResult,
+  type ToolRunContext,
+} from '@deepseek-ai/dsh-tools'
+import type { JsonValue } from '@deepseek-ai/dsh-util-values'
+import { hostDispatchers } from '../../agent-loop/src/internal.ts'
+import { MockAdapter, textResponse, toolCallResponse } from '../../agent-loop/tests/mock-adapter.ts'
+
+/** One live host: registries, the loop (which claims the authority), and a scripted model. */
+async function harness(script: ReturnType<typeof textResponse>[] = [textResponse('done')]) {
+  const ctx = new Context()
+  await ctx.plugin(LlmRuntime)
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(SystemPrompt, { personaPrefix: '' })
+  await ctx.plugin(ToolRuntime)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  ctx.llm.registerAdapter(['mock'], new MockAdapter(script))
+  onTestFinished(() => ctx.fiber.dispose())
+  return ctx
+}
+
+/** A real, registry-registered agent on this host (what a plugin reads from `ctx.agents.list()`). */
+async function liveAgent(ctx: Context, id: string): Promise<Agent> {
+  const { agent } = await ctx.agents.create({
+    sessionId: SessionId(id),
+    agentOptions: { provider: 'mock', model: 'mock' },
+  })
+  return agent
+}
+
+function waitForIdle(ctx: Context, agent: Agent): Promise<void> {
+  return new Promise((resolve) => {
+    const dispose = ctx.on('agent/status', ({ agent: subject, status }) => {
+      if (subject === agent && status === 'idle') { dispose(); resolve() }
+    })
+  })
+}
+
+function followup(agent: Agent, text = 'go'): void {
+  agent.followup(createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }))
+}
+
+/** A probe tool that records every execution object it is handed. */
+function probeTool(seen: ToolRunContext[]): ReturnType<typeof defineTool> {
+  return defineTool({
+    name: 'probe',
+    description: 'provenance probe',
+    parameters: {},
+    output: {
+      schema: { type: 'string' },
+      render: (_args, value) => [{ type: 'text', text: value }] as ContentBlock[],
+    },
+    async execute(_args, exec): Promise<JsonValue> {
+      seen.push(exec)
+      return 'probed'
+    },
+  })
+}
+
+/** The authority the harnessed loop claimed. Test-only handle; a plugin has no path to it. */
+function authorityOf(ctx: Context) {
+  const authority = hostDispatchers.get(ctx.root)?.authority
+  if (authority === undefined) throw new Error('test harness: the agent loop claimed no dispatch authority')
+  return authority
+}
+
+function expectUntrusted(result: ToolExecutionResult): void {
+  expect(result.isError).toBe(true)
+  expect(result.error?.info?.code).toBe(TOOL_EXEC_UNTRUSTED)
+}
+
+function expectInvalid(result: ToolExecutionResult): void {
+  expect(result.isError).toBe(true)
+  expect(result.error?.info?.code).toBe(TOOL_EXEC_INVALID)
+}
+
+describe('host tool-execution provenance', () => {
+  it('T01 a plugin-built exec is refused by the public entry', async () => {
+    const ctx = await harness()
+    const seen: ToolRunContext[] = []
+    ctx.tools.register(probeTool(seen))
+    const agent = await liveAgent(ctx, 't01-agent')
+
+    const forged: ToolExecutionInput = {
+      callId: ToolCallId('forged'),
+      name: 'probe',
+      arguments: {},
+      agent,
+      signal: new AbortController().signal,
+    }
+    expectUntrusted(await ctx.tools.execute(forged))
+    expect(seen).toHaveLength(0)
+
+    // The same refusal holds without an agent: once a host dispatcher exists,
+    // the unprivileged entry is closed for every caller-supplied input.
+    expectUntrusted(await ctx.tools.execute({ ...forged, agent: undefined }))
+    expect(seen).toHaveLength(0)
+  })
+
+  it('T02 a forged exec carrying the real owner agent is refused', async () => {
+    const ctx = await harness()
+    const seen: ToolRunContext[] = []
+    ctx.tools.register(probeTool(seen))
+    const owner = await liveAgent(ctx, 't02-owner')
+    // Exactly the live object another plugin reads from `ctx.agents.list()`.
+    expect(ctx.agents.list()).toContain(owner)
+
+    const result = await ctx.tools.execute({
+      callId: ToolCallId('borrow-owner'),
+      name: 'probe',
+      arguments: {},
+      agent: owner,
+      signal: new AbortController().signal,
+    })
+    expectUntrusted(result)
+    expect(seen).toHaveLength(0)
+  })
+
+  it('T03 a registry-minted exec copied out of a handler cannot be re-executed', async () => {
+    const ctx = await harness([toolCallResponse('c1', 'probe', {}), textResponse('done')])
+    const seen: ToolRunContext[] = []
+    ctx.tools.register(probeTool(seen))
+    const agent = await liveAgent(ctx, 't03-agent')
+    const idle = waitForIdle(ctx, agent)
+    followup(agent)
+    await idle
+
+    expect(seen).toHaveLength(1)
+    const genuine = seen[0]!
+
+    // Replay the exact object, and every cheap copy shape a plugin would try.
+    expectUntrusted(await ctx.tools.execute(genuine))
+    expectUntrusted(await ctx.tools.execute({ ...genuine }))
+    // A JSON round-trip loses the token and the context methods entirely; the
+    // reconstructed input is still refused (as untrusted, because a host
+    // dispatcher exists, or as invalid when a required field is missing).
+    const jsonCopy = {
+      callId: JSON.parse(JSON.stringify(genuine.callId)) as string,
+      name: JSON.parse(JSON.stringify(genuine.name)) as string,
+      arguments: {},
+      signal: new AbortController().signal,
+    } as ToolExecutionInput
+    expectUntrusted(await ctx.tools.execute(jsonCopy))
+    expect(seen).toHaveLength(1)
+  })
+
+  it('T04 a live exec cannot be retargeted to another agent or session', async () => {
+    const ctx = await harness([toolCallResponse('c1', 'probe', {}), textResponse('done')])
+    const seen: ToolRunContext[] = []
+    ctx.tools.register(probeTool(seen))
+    const agent = await liveAgent(ctx, 't04-agent')
+    const other = await liveAgent(ctx, 't04-other')
+    const idle = waitForIdle(ctx, agent)
+    followup(agent)
+    await idle
+    const genuine = seen[0]!
+
+    // The identity fields are locked for the execution's whole life.
+    const mutable = genuine as unknown as { agent?: Agent; name?: string }
+    expect(() => { mutable.agent = other }).toThrow(TypeError)
+    expect(() => { mutable.name = 'other-tool' }).toThrow(TypeError)
+    expect(genuine.agent).toBe(agent)
+    expect(genuine.name).toBe('probe')
+
+    // A rewritten copy is still refused before any policy or body runs.
+    expectUntrusted(await ctx.tools.execute({ ...genuine, agent: other }))
+    expect(seen).toHaveLength(1)
+  })
+
+  it('T05 withInitiator is causal attribution, not an authorization token', async () => {
+    const ctx = await harness()
