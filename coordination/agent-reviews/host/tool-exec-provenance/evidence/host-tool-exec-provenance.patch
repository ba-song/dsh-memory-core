+    const bare = new Context()
+    await bare.plugin(SystemPrompt, { personaPrefix: '' })
+    await bare.plugin(ToolRuntime)
+    onTestFinished(() => bare.fiber.dispose())
+    const seen: ToolRunContext[] = []
+    bare.tools.register(probeTool(seen))
+
+    expectInvalid(await bare.tools.execute(null as unknown as ToolExecutionInput))
+    expectInvalid(await bare.tools.execute({} as ToolExecutionInput))
+    expectInvalid(await bare.tools.execute({
+      callId: ToolCallId('t13'), name: '', signal: new AbortController().signal,
+    }))
+    expectInvalid(await bare.tools.execute({
+      callId: ToolCallId('t13'), name: 'probe', signal: {} as AbortSignal,
+    }))
